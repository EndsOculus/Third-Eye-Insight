# Whitelist mode: ignore everything by default
*

# Allow descending into directories so specific files can be unignored
!*/

# Keep this file
!.gitignore

# Project docs and metadata
!README.md
!CHANGELOG.md
!LICENSE
!pyproject.toml
!uv.lock

# Core source files (release subset)
!train.py
!main.py
!app_pipeline.py
!extract_chat_data.py
!reporting.py
!runtime_config.py
!visualization.py

# Utility scripts
!run_train.ps1
!apply_torch_source_from_config.ps1

# Use template config for publishing (keep real config.json ignored)
!config.example.json

# Explicit safety ignores
config.json
*.db
*.enctemp
output/
.venv/
__pycache__/

# Desktop and complete core release
!analysis_types.py
!embedding_cache.py
!metrics.py
!desktop.py
!desktop_core.py
!Start Insight.vbs
!debug_desktop.ps1
!tests/test_desktop.py
!tests/test_core_safety.py
!tests/test_entrypoint.py
!tests/test_extract.py
!tests/test_visualization.py
!VALIDATION.md
!SECURITY.md
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
*.zip
*.bundle
.cache/
.pytest_cache/
.ruff_cache/
!/.github/workflows/tests.yml
